# Telegram
BOT_TOKEN=123456:replace_me
BOT_USERNAME=your_bot_username
SUPERADMIN_IDS=123456789
PUBLIC_BASE_URL=https://bot.example.com
FEEDBACK_USERNAME=your_username
MATERIAL_CHANNEL_ID=-1001234567890
MATERIAL_CHANNEL_USERNAME=your_public_material_channel

# Infrastructure
DOMAIN=bot.example.com
POSTGRES_DB=cats
POSTGRES_USER=cats
POSTGRES_PASSWORD=replace_with_a_long_password
DATABASE_URL=postgresql+asyncpg://cats:replace_with_a_long_password@postgres:5432/cats
APP_SECRET=replace_with_at_least_32_random_characters
LOGIN_CODE_PEPPER=replace_with_another_random_secret

# Product defaults
DEFAULT_TASK_LIMIT=10
LOGIN_TTL_SECONDS=300
DEFAULT_TIMEZONE=Asia/Shanghai
SCHEDULER_CONCURRENCY=20
